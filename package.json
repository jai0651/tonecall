{
  "name": "tonecall",
  "version": "0.0.1",
  "private": true,
  "description": "Inter-Agent Voice Handshake — fax tones for AI agents, brokered by Plivo.",
  "scripts": {
    "dev": "node --env-file=.env --import tsx server.ts",
    "dev:a": "AGENT_OWNED=vegetable_vendor PORT=3000 node --env-file=.env --import tsx server.ts",
    "dev:b": "AGENT_OWNED=pizza_shop PORT=3001 PUBLIC_HOST=${PUBLIC_HOST_B:-localhost:3001} BROKER_URL=${BROKER_URL:-http://localhost:3000} FORWARD_EVENTS_TO=${FORWARD_EVENTS_TO:-http://localhost:3000} node --env-file=.env --import tsx server.ts",
    "build": "next build",
    "start": "NODE_ENV=production node --env-file=.env --import tsx server.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^15.0.0",
    "openai": "^6.39.0",
    "plivo": "^4.61.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
